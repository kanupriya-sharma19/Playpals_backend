generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String                 @id @default(cuid())
  name                 String
  email                String                 @unique
  password             String
  dob                  DateTime?
  gender               String?
  city                 String?
  gamePreferences      String[]
  profilePhoto         String?
  resetToken           String?                @unique
  resetTokenExpiration DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  phoneNumber          String                 @default("N/A")
  isEmailVerified      Boolean                @default(false)
  role                 Role                   @default(USER)
  bookings             Booking[]
  reviews              Review[]               @relation("UserReviews")
  ownedAmenities       SportsAmenity[]        @relation("UserRentals")
  amenityBookings      SportsAmenityBooking[] @relation("UserBookings")
}

model Review {
  id        String    @id @default(cuid())
  user      User      @relation(name: "UserReviews", fields: [userId], references: [id])
  userId    String
  turf      Turf      @relation(name: "TurfReviews", fields: [turfId], references: [id])
  turfId    String
  rating    Float     @default(0.0)
  comment   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bookings  Booking[]
  photo     String?
}

enum Status {
  PENDING
  CONFIRMED
  COMPLETED
}

model Booking {
  id            String   @id @default(cuid())
  turfId        String
  userId        String
  numberOfSeats Int
  day           String
  bookedFrom    DateTime
  bookedTo      DateTime
  status        Status   @default(PENDING)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  turf          Turf     @relation(fields: [turfId], references: [id])
  user          User     @relation(fields: [userId], references: [id])
  Review        Review?  @relation(fields: [reviewId], references: [id])
  reviewId      String?
}

enum Role {
  ADMIN
  USER
  TURFOWNER
}

model SportsAmenity {
  id           String   @id @default(cuid())
  name         String
  description  String?
  category     String
  pricePerHour Float
  quantity     Int
  photos       String[] @default([])
  isAvailable  Boolean  @default(true)

  ownerType AmenityOwnerType

  userId      String?
  turfOwnerId String?
  turfId      String?

  ownerUser User? @relation(fields: [userId], references: [id], name: "UserRentals", map: "SportsAmenity_User_fkey")
  ownerTurf Turf? @relation(fields: [turfOwnerId], references: [id], name: "TurfOwnerRentals", map: "SportsAmenity_TurfOwner_fkey")

  bookings SportsAmenityBooking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Turf      Turf?    @relation(fields: [turfId], references: [id])
}

model SportsAmenityBooking {
  id         String        @id @default(cuid())
  userId     String
  amenityId  String
  bookedFrom DateTime
  bookedTo   DateTime
  quantity   Int
  totalPrice Float
  status     BookingStatus @default(PENDING)

  user    User          @relation(fields: [userId], references: [id], name: "UserBookings")
  amenity SportsAmenity @relation(fields: [amenityId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AmenityOwnerType {
  USER
  TURFOWNER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum TurfOwnerType {
  INDIVIDUAL
  ORGANIZATION
}

model Owner {
  id                   String        @id @default(cuid())
  name                 String?
  email                String        @unique
  password             String
  profilePhoto         String?
  phoneNumber          String
  ownerType            TurfOwnerType
  organizationName     String?
  registrationNumber   String?
  contactPersonName    String?
  contactPersonPhone   String?
  turfs                Turf[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  resetToken           String?       @unique
  resetTokenExpiration DateTime?
}

model Turf {
  id                String          @id @default(cuid())
  turfName          String
  turfDescription   String?
  turfLocation      String
  turfSize          String?
  turfGames         String[]
  amenities         String[]
  ratings           Float           @default(0.0)
  countReviews      Int             @default(0)
  pricePerPerson    Float?
  totalSeats        Int?
  availableSeats    Int             @default(0)
  available         Boolean         @default(true)
  availabilitySlots Json?
  turfPhoto         String[]
  ownerId           String
  owner             Owner           @relation(fields: [ownerId], references: [id])
  bookings          Booking[]
  reviews           Review[]        @relation("TurfReviews")
  ownedAmenities    SportsAmenity[] @relation("TurfOwnerRentals")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  SportsAmenity     SportsAmenity[]
}
